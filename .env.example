# Security
JWT_SECRET_KEY=generate-a-secure-random-key-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Storage Locations
DATABASE_PATH=./data/media.db
THUMBNAILS_DIR=./data/thumbnails

# Server Network Settings
HOST=0.0.0.0
PORT=8000
